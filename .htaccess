Options -Indexes
DirectoryIndex index.html index.php
AddType video/mp4 .mp4

<IfModule mod_rewrite.c>
  RewriteEngine On
  # บังคับ HTTPS เฉพาะบนโดเมนจริง (บนเครื่อง XAMPP / IP ในวง LAN ไม่โดน)
  RewriteCond %{HTTP_HOST} ^loykrathong\.retc\.ac\.th$ [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ไม่ให้ดาวน์โหลดไฟล์ระบบ / git
<FilesMatch "^\.|\.(md|yml)$">
  Require all denied
</FilesMatch>

# ให้เบราว์เซอร์เก็บวิดีโอไว้ ไม่ต้องโหลด 351MB ใหม่ทุกครั้งที่เปิดหน้า
<IfModule mod_headers.c>
  <FilesMatch "\.mp4$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
